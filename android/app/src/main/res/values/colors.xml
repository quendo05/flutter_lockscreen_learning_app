<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's palette, taken straight from the brand sheet in assets/brand/.

     There is deliberately no values-night variant. The widget keeps one dark
     treatment in both system themes, which is what the brand sheet draws and
     what makes Saffron usable at all: on a light panel it falls to about 1.8:1
     against the text it would have to carry. A lock screen widget also reads
     better as a dark scrim over an unknown wallpaper than as a light slab. -->
<resources>
    <color name="widget_on_surface">#FFFFFF</color>
    <color name="widget_on_surface_variant">#CFC4DE</color>

    <!-- Saffron. The brand sheet gives the translation line this colour, and it
         holds 6.0:1 on the translucent panel over a white wallpaper — the worst
         case — so it stays legible rather than merely on-brand. -->
    <color name="widget_accent">#F2A33C</color>
</resources>
