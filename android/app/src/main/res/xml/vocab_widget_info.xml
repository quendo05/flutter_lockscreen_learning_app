<?xml version="1.0" encoding="utf-8"?>
<!-- Attributes here are the ones every supported release understands. The
     API 31+ additions live in the xml-v31/ copy of this file rather than here,
     or lint flags them on older devices. The lock screen opt-out
     (`android:widgetCategory="not_keyguard"`) would work the same way, in
     res/xml-v36/ — not wanted, since the lock screen is the point.

     minWidth/minHeight are the floor the user may squash to, not the size the
     widget wants. They are set low so a single lock screen row is a legal
     placement; VocabWidget's smallest size bucket is drawn for exactly this.

     `initialLayout` is still required even though Glance builds the real
     RemoteViews itself, so it points at the placeholder Glance ships for
     exactly this: it is on screen only until the first composition lands.

     `previewImage` is what the picker shows below API 31, where
     `previewLayout` does not exist. The brand icon is a poor likeness of the
     widget but a far better one than the loading placeholder. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/vocab_widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewImage="@mipmap/ic_launcher"
    android:minWidth="110dp"
    android:minHeight="48dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="1800000" />
