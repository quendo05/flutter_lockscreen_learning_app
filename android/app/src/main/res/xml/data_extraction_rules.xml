<?xml version="1.0" encoding="utf-8"?>
<!-- The API 31+ form of backup_rules.xml; see there for the reasoning.

     device-transfer repeats cloud-backup rather than inheriting it: a
     phone-to-phone transfer would otherwise carry across the stale queue that
     cloud backup deliberately leaves behind. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="schedule.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="schedule.json" />
    </device-transfer>
</data-extraction-rules>
