<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately bare: scaffolding for the real design, not the design.

     Worth knowing before replacing it: this is rendered by the launcher in
     another process, so only the views RemoteViews supports may appear here —
     LinearLayout, RelativeLayout, FrameLayout, GridLayout, TextView,
     ImageView, Button and a handful more. No custom views, no ConstraintLayout,
     no findViewById at runtime. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vocab_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/vocab_widget_term"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="@string/vocab_widget_empty_term" />

    <TextView
        android:id="@+id/vocab_widget_translation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="14sp"
        android:text="@string/vocab_widget_empty_translation" />
</LinearLayout>
