<?xml version="1.0" encoding="utf-8"?>
<!-- The dark counterpart. Same reasoning as drawable/widget_surface.xml; the rim
     drops to 18% white because a bright edge on a dark panel reads as a glow
     rather than as a highlight. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/widget_corner_radius" />
    <gradient
        android:angle="270"
        android:startColor="#E62A312E"
        android:endColor="#D6141A17"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#2EFFFFFF" />
</shape>
