<?xml version="1.0" encoding="utf-8"?>
<!-- The widget panel, from the brand sheet's Lockscreen-Widget card.

     There is no backdrop blur to be had: the launcher composites the widget and
     nothing in RemoteViews can sample what sits behind it, so RenderEffect is
     not an option. What is real is the transparency — the wallpaper genuinely
     shows through this fill, which is why the panel reads as glass rather than
     as a painted rectangle.

     The gradient runs Plum 800 to Plum 900, the same fall the app icon uses.
     The stroke is the sheet's 14% white rim.

     Alpha stays at 88% on purpose. The fill sits over a wallpaper nobody has
     seen, so contrast has to hold at both extremes: at this alpha the white
     term clears 12.6:1 and the Saffron translation 6.0:1 against a white
     wallpaper, and both improve against a black one. More transparency
     photographs better and fails in use. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/widget_corner_radius" />
    <gradient
        android:angle="270"
        android:startColor="#E02A1350"
        android:endColor="#E01E1233"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#24FFFFFF" />
</shape>
